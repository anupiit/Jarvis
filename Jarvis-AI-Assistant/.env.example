# Copy this file to .env (same folder as package.json) and fill in your own values.
# .env is git-ignored. Never commit a real key.

# Required: your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: the model used for planning and code generation.
# Run `models` or `diagnose` inside Jarvis to see which models your key can use.
GEMINI_MODEL=gemini-flash-latest
