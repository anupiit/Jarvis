# Copy this file to .env (same folder as package.json) and fill in your own values.
# .env is git-ignored. Never commit a real key.

# Provider routing:
#   auto   (default) Claude first; Gemini automatically takes over when Claude has no credit/quota,
#          is rejected (auth/config), is rate limited for long, or is down.
#   claude / gemini  use only that provider (no fallback).
AI_PROVIDER=auto
# Set to false to disable the automatic Gemini fallback.
AI_FALLBACK_ENABLED=true

# --- Claude (primary) ---  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (default high). Leave empty for models without effort support.
CLAUDE_EFFORT=high

# --- Gemini (free-tier fallback) ---  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# --- Optional routing / cost controls (all have safe defaults) ---
# Seconds a provider is skipped after a billing/quota/auth/config failure (default 900).
# AI_PROVIDER_COOLDOWN_SEC=900
# Seconds a provider is skipped after an outage/rate limit that survived retries (default 60).
# AI_PROVIDER_TRANSIENT_COOLDOWN_SEC=60
# Local, per-run safety limits on ESTIMATED spend, in USD. When reached, that provider is skipped.
# Jarvis never buys credits or enables automatic top-ups.
# AI_CLAUDE_SPEND_LIMIT_USD=5
# AI_GEMINI_SPEND_LIMIT_USD=
# Cost estimates use list prices; override per million tokens if yours differ (Gemini defaults to $0).
# AI_PRICE_CLAUDE_IN_PER_MTOK=
# AI_PRICE_CLAUDE_OUT_PER_MTOK=
# AI_PRICE_GEMINI_IN_PER_MTOK=
# AI_PRICE_GEMINI_OUT_PER_MTOK=
